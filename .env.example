# Supabase Configuration
SUPABASE_URL=URL
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_FALLBACK_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=coral

# Google Cloud Configuration (for TTS/ASR)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GMAPS_KEY=your_google_maps_api_key
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=freeflow-voiceorder
GCP_LOCATION=europe-west4
GOOGLE_TTS_API_KEY=TTS

# Server Configuration
PORT=3003
HOST=0.0.0.0

# Reco V1 — Rule-based dish recommendations
RECO_V1_ENABLED=false
RECO_V1_DEBUG=false

# Public demo catalog: when true, discovery and direct name matching expose
# only the five fictional FreeFlow restaurants. Existing database rows remain intact.
FREEFLOW_DEMO_CATALOG_ONLY=false
