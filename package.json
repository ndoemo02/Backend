{
  "name": "freeflow-backend",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "api/server-vercel.js",
  "scripts": {
    "start": "node server.js",
    "start:ws": "node api/voice/live/standalone-server.js",
    "dev": "node api/server-vercel.js",
    "vercel-build": "echo Using server-vercel.js handler",
    "postpatch": "node dev-tools/postpatch.cjs",
    "log": "node -e \"import('./dev-tools/patchLogger.js').then(m => m.logCursorPatch('Manual log', process.argv[1]))\"",
    "test": "vitest run tests/unit",
    "test:full": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:performance": "vitest run tests/performance",
    "patch:nlu": "node scripts/amber-nlu-patcher.js",
    "test:logic": "vitest run tests/brain-logic-flow.test.js --reporter=verbose",
    "test:lastLocation": "vitest run tests/brain-cascade.test.js -t \"should remember last location\" --reporter=verbose",
    "test:critical": "vitest run tests/brain-cascade.test.js -t \"Tier 11\" --reporter=verbose",
    "test:fallback": "vitest run tests/brain-fallback.test.js --reporter=verbose",
    "test:summary": "node scripts/amber-test-summary.js",
    "test:parse": "node tests/test-parse.js",
    "test:brain": "node run-brain-tests.js",
    "test:brain:e2e": "vitest run api/brain/tests/brainRouter.e2e.test.js",
    "test:live:tools": "vitest run api/brain/tests/liveToolRouter.test.js",
    "test:live:cascade": "node api/brain/tests/live_tool_cascade_runner.js",
    "test:discovery": "vitest run api/brain/tests/discoveryTaxonomy.test.js api/brain/tests/discovery_adapter_db_compat.test.js api/brain/tests/itemTaxonomyVerification.test.js",
    "test:mc:direct": "vitest run api/brain/tests/monteCarlo_direct.e2e.test.js",
    "test:mc:std": "vitest run api/brain/tests/monteCarlo_std.e2e.test.js",
    "test:orders": "npx vitest tests/orders-api.test.js --run",
    "scan:encoding": "node scripts/scanEncoding.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "1.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.2",
    "ai": "^6.0.5",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.0",
    "stripe": "^22.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "supertest": "^6.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
